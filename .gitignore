# 큰 것들은 절대 들어오지 않게 (씨앗은 작게 유지한다)
*.apk
*.zip
*.tar.gz
*.AppImage
jdk/
qgc/
rosettadrone/

# 파이썬 캐시
__pycache__/
*.pyc

# colcon 산출물 (ros2/src 만 저장소에 둔다)
ros2/build/
ros2/install/
ros2/log/
# 최상위에서 colcon build 를 잘못 돌리면 여기에도 생긴다. 실제 워크스페이스는 ros2/ 다
/build/
/install/
/log/

# 캘리브레이션 원본 이미지 (결과 파일만 저장소에 둔다)
calibrationdata/*.png

# understand-anything 산출물 (지식그래프 — 다시 만들면 된다)
.ua/
